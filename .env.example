NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Fixture mode is the safe default. It does not contact Dext.
DEXT_DATA_SOURCE=fixture
DEXT_LIVE_REQUESTS_ENABLED=false

# Durable storage is mandatory for live and production modes.
STORAGE_MODE=memory
DATABASE_URL=

# Local MCP authentication. Production rejects this mode.
AUTH_MODE=development
ALLOW_DEVELOPMENT_AUTH=true
DEVELOPMENT_AUTH_TOKEN=local-dev-token-change-me
DEVELOPMENT_TENANT_ID=local-tenant
DEVELOPMENT_USER_ID=local-user

# Production OAuth configuration.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
OAUTH_AUTHORIZATION_SERVER=

# Production secrets must come from a secret manager. CREDENTIAL_MASTER_KEY is
# a base64url-encoded 32-byte AES key. It decrypts per-connection data keys; no
# global Dext token is accepted by the process configuration.
CREDENTIAL_MASTER_KEY=
CURSOR_ENCRYPTION_KEY=local-development-cursor-key-change-me

# Maximum detail endpoint calls made by one risk-search page (1-50).
RISK_DETAIL_REQUEST_BUDGET=40
