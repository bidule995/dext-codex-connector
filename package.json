{
  "name": "dext-codex-connector",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Codex plugin and authenticated MCP connector for read-only Dext Data Health and Commerce access.",
  "license": "Apache-2.0",
  "author": "César Cros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidule995/dext-codex-connector.git"
  },
  "bugs": {
    "url": "https://github.com/bidule995/dext-codex-connector/issues"
  },
  "homepage": "https://github.com/bidule995/dext-codex-connector#readme",
  "files": [
    ".agents",
    ".codex-plugin",
    ".mcp.json",
    "assets",
    "dist",
    "migrations",
    "docs",
    ".env.example",
    "Dockerfile",
    "compose.yaml",
    "LICENSE",
    "NOTICE",
    "plugin/runtime",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:plugin",
    "check:plugin": "node scripts/build-plugin.mjs --check && node scripts/validate-plugin.mjs",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "lint": "eslint src tests --max-warnings=0",
    "release:verify": "node scripts/verify-release-version.mjs",
    "release:verify-hosted": "node scripts/verify-hosted-release.mjs",
    "plugin:prepare-hosted": "node scripts/prepare-hosted-plugin.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:packaging:static": "vitest run tests/contract/packaging-security.test.ts",
    "test:packaging:docker": "node scripts/verify-docker-secret-boundary.mjs",
    "test:security": "vitest run tests/security",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.10.0",
    "jose": "6.2.4",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.2",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
